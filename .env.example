# Copy to .env and add a key. Keys stay server-side — the browser never sees them.

# --- Groq (default) -------------------------------------------------------
# Free tier, and the fastest of the three: https://console.groq.com/keys
GROQ_API_KEY=

# --- Alternatives (optional) ----------------------------------------------
# GEMINI_API_KEY=      # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=   # https://console.anthropic.com

# --- Overrides ------------------------------------------------------------
# First key found wins, in the order groq -> gemini -> anthropic.
# Force one with:
# LLM_PROVIDER=groq | gemini | anthropic
#
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_MODEL=claude-opus-5
# PORT=8787
